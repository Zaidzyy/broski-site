{
  "name": "broski-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Broski: the public landing page and README.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "assets": "node scripts/images.mjs && node scripts/subset-arabic.mjs",
    "og": "node scripts/og.mjs",
    "contrast": "node scripts/contrast.mjs",
    "test": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "readme": "node --experimental-strip-types --no-warnings scripts/readme.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "lighthouse": "^12.8.2",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "gsap": "^3.15.0"
  }
}
